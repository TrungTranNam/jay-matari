DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/jaymataji"
AUTH_SECRET="run: openssl rand -base64 32"
# behind our own proxy (nginx / localhost); set AUTH_URL instead if you prefer
AUTH_TRUST_HOST=true
SHADOW_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/jaymataji_shadow"
ADMIN_EMAIL="admin@jaymataji.com"
ADMIN_PASSWORD="choose-a-strong-one"

# Online payments (optional). Without these the "card, netbanking, wallet" option is hidden.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Order emails (optional). Without SMTP_URL mails are printed to the server log.
SMTP_URL=""            # smtp://user:pass@smtp.example.com:587
MAIL_FROM=""           # Jay Mataji Creation <care@jaymataji.com>
ORDERS_EMAIL=""        # where new-order alerts go; defaults to the footer email
